{
  "name": "kariakoo-backend",
  "version": "0.1.0",
  "description": "Kariakoo SaaS platform — backend (Phase 1 foundation: multi-tenancy + auth + RBAC)",
  "scripts": {
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main",
